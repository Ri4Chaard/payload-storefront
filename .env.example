# Copy to .env and fill in. Never commit .env — Constitution VI.
# Every variable listed here is REQUIRED; startup fails naming any that is missing (FR-006).

# Postgres connection. Matches docker-compose.yml for local development.
DATABASE_URI=postgres://aurum:aurum@localhost:5432/aurum

# Payload encryption secret. Generate with: openssl rand -base64 32
# Must be rotatable without a code change.
PAYLOAD_SECRET=

# Public origin of this deployment. Used for absolute URLs and canonical tags.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional. The shop's name: wordmark, footer, page titles, admin title, email subjects.
# Inlined at build time, so changing it needs a rebuild. Defaults to "Aurum".
# NEXT_PUBLIC_SITE_NAME=Aurum

# --- Email (spec 004: customer accounts) -------------------------------------
# Transactional mail — verification codes, password-reset codes, password-change
# notices — is sent through Resend. Registration cannot complete without it, so
# both variables below are REQUIRED and startup fails naming a missing one.

# Resend API key. A sending key is enough. Secret; rotatable without a code change.
RESEND_API_KEY=

# The sending identity. Must be on a domain verified in Resend, or sends are rejected.
# Locally you can use onboarding@resend.dev, which Resend accepts without a verified
# domain — but it only delivers to the address that owns the API key. That is enough
# to run every flow on your own machine and NOT enough for a shared environment,
# where every tester would receive nobody's codes.
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Optional. The name shown beside the address in the inbox. Defaults to NEXT_PUBLIC_SITE_NAME.
# Set it on staging ("Aurum (staging)") so a stray message is obvious.
# EMAIL_FROM_NAME=Aurum

# Optional, and MUST be unset in production. Redirects every message to this one
# address instead of the customer's. Set it on any environment whose database may
# hold real customer addresses — a restored production dump on staging is the usual
# way a test run mails real people.
# EMAIL_OVERRIDE_RECIPIENT=

# Optional, and set by the test runners rather than by a person. `log` swaps the Resend
# adapter for one that writes the recipient and subject to the log and sends nothing, so
# `pnpm test:integration` and `pnpm test:e2e` do not spend a real quota — before this the
# suites mailed through a live account, and the day the quota ran out they failed as
# "no reset code was issued". Anything other than `log` sends normally, so an unset value
# means send. Do not set it in an environment that is supposed to mail anybody.
# EMAIL_TRANSPORT=log

# Optional. The Resend AUDIENCE that marketing consent is mirrored into (US6). Create an
# audience in the Resend dashboard and paste its id here. Unset is a supported state, not a
# broken one: consent is still recorded, stamped and shown on the profile — Payload is the
# source of truth for it — and `src/lib/email/marketing.ts` simply has nowhere to mirror it
# to, which it logs at debug and swallows. Set it wherever campaigns are actually sent from,
# because a campaign built against an audience that never learned about an opt-out is the
# failure this mirror exists to prevent.
#
# It is NOT a second sending credential and cannot send anything. Marketing mail is composed
# and sent by a person, in Resend, against this audience; the application never sends it.
# RESEND_AUDIENCE_ID=

# --- Deployment (docker compose --profile prod) -------------------------------
# DATABASE_URI above points at the separately provisioned database — `host.docker.internal`
# rather than `localhost` if it runs on the same host as the container.
#
# Optional; the compose file defaults these.
# APP_PORT=3000                # published port for the reverse proxy to sit in front of
#
# Local Postgres (docker compose --profile local) defaults to aurum/aurum/aurum.
# POSTGRES_USER=aurum
# POSTGRES_PASSWORD=aurum
# POSTGRES_DB=aurum
